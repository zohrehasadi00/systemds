// Built-in for deduplication using distributed representations + LSH blocking.
// — Fixed vocabulary lookup to use a simple in-memory index
// — Handle zero-vector and NaN cases explicitly
// — Seeded LSH hyperplanes for reproducibility
// — Skip singleton buckets to avoid quadratic blow-up
// — Simplified duplicate‐index extraction

f_dedup = function( Frame[String] X,
                    Matrix[Double] gloveMatrix,
                    Frame[String] vocab,
                    String similarityMeasure = "cosine",
                    Double threshold = 0.8 )
  return( Frame[String] Y_unique, Frame[String] Y_duplicates )
{
  # 1) Build a simple lookup map from vocab terms to indices
  vocabTerms = toString(vocab)        # flatten vocab frame into string vector
  vocabIndex = createIndexMap(vocabTerms) # { term -> rowIndex }

  # 2) Compute DR matrix V (n × e)
  V = computeDRMatrix(X, gloveMatrix, vocabIndex)

  # 3) Clean up any NaNs (e.g. zero-norm cosine cases)
  V[isnan(V)] = 0

  # 4) Generate reproducible LSH hyperplanes
  K = 10
  seed = 12345
  d = ncol(V)
  H = rand(rows=K, cols=d, pdf="uniform", seed=seed)

  # 5) Compute K-bit hash codes per row
  P = V %*% t(H)
  hashCodes = (P >= 0)

  # 6) Bucket IDs (treat each bit-row as a binary number)
  powers = 2 ^ ( (K-1) : 0 )
  bucketIDs = hashCodes %*% t(powers)

  # 7) Find candidate pairs, skipping buckets of size 1
  pairs = matrix(0, rows=0, cols=2)
  uniqueBuckets = table(bucketIDs)
  for (b in uniqueBuckets$key) {
    if (uniqueBuckets[b] > 1) {
      idx = which(bucketIDs == b)
      for (i in 1:(length(idx)-1))
        for (j in (i+1):length(idx))
          pairs = rbind(pairs, matrix(c(idx[i], idx[j]), 1, 2))
    }
  }

  # 8) Compute similarities
  sim = computeSimilarity(V, pairs, similarityMeasure)

  # 9) Filter to true duplicates
  matches = pairs[ sim >= threshold , ]

  # 10) Mark duplicate indices (always drop the higher-indexed row)
  dupMask = matrix(1, rows=nrow(X), cols=1)
  if (nrow(matches) > 0) {
    for (r in 1:nrow(matches))
      dupMask[matches[r,2],1] = 0
  }

  # 11) Split into unique vs. duplicates
  keepIdx = which(dupMask == 1)
  dropIdx = which(dupMask == 0)

  Y_unique     = X[keepIdx, ]
  Y_duplicates = X[dropIdx, ]
}

# Helper: computeDRMatrix with in-memory vocabIndex lookup
computeDRMatrix = function( Frame[String] X,
                            Matrix[Double] gloveMatrix,
                            Map[String,Int] vocabIndex )
  return( Matrix[Double] V )
{
  n = nrow(X)
  e = ncol(gloveMatrix)
  V = matrix(0, rows=n, cols=e)

  for (i in 1:n) {
    tokens = UtilFunctions.cleanAndTokenizeRow(X[i,])
    sumVec = matrix(0, rows=1, cols=e)
    count  = 0

    for (w in tokens) {
      if (vocabIndex.contains(w)) {
        idx = vocabIndex.get(w)
        sumVec = sumVec + gloveMatrix[idx, ]
        count  = count + 1
      }
    }
    if (count > 0)
      V[i, ] = sumVec / count
    # else leave as zero-vector
  }
  V
}

# computeSimilarity unchanged except zero-norm guard
computeSimilarity = function( Matrix[Double] V,
                              Matrix[Double] pairs,
                              String similarityMeasure )
  return( Matrix[Double] sim )
{
  m = nrow(pairs)
  sim = matrix(0.0, rows=m, cols=1)
  for (k in 1:m) {
    i = pairs[k,1]; j = pairs[k,2]
    vi = V[i,]; vj = V[j,]

    if (similarityMeasure == "cosine") {
      norm_i = sqrt(sum(vi^2)); norm_j = sqrt(sum(vj^2))
      sim[k,1] = if (norm_i>0 & norm_j>0) sum(vi*vj)/(norm_i*norm_j) else 0
    } else if (similarityMeasure == "euclidean") {
      sim[k,1] = -sqrt(sum((vi - vj)^2))
    } else {
      stop("Unsupported similarity measure: "+similarityMeasure)
    }
  }
  sim
}
