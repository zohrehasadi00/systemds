#
# Builtin for deduplication using distributed representations (DRs)
# and locality-sensitive hashing (LSH) based blocking.
#

f_dedup = function(
    Frame[String] X,
    Matrix[Double] gloveMatrix,
    Matrix[String] vocab,
    String similarityMeasure = "cosine",
    Boolean returnDuplicates = FALSE)
  return(Frame[String] Y)
{
  #### Step 1: Distributed Representation (DRs) ####
  V = computeDRMatrix(X, vocab, gloveMatrix)

  #### Step 2: Generate LSH Hyperplanes ####
  K = 10
  d = ncol(V)
  H = rand(rows=K, cols=d, pdf="uniform", seed=-1)

  #### Step 3: Compute LSH Hashcodes ####
  hashCodes = computeLSH(V, H)

  #### Step 4: Form Buckets ####
  bucketIDs = formBuckets(hashCodes)

  #### Step 5: Candidate Pair Generation ####
  pairs = findCandidatePairs(bucketIDs)

  #### Step 6: Compute Similarity for Pairs ####
  sim = computeSimilarity(V, pairs, similarityMeasure)

  #### Step 7: Filter by Threshold ####
  threshold = 0.8
  # Boolean mask of matching pairs
  keepMask = sim >= threshold           # Vector of length m
  matchedPairs = pairs[keepMask, ]      # Subset rows

  #### Step 8: Identify Duplicate Indices ####
  n = nrow(X)
  # Initialize flag vector
  dupFlag = matrix(0, rows=n, cols=1)
  # Mark duplicates (second element of each matched pair)
  for (i in 1:nrow(matchedPairs)) {
    idx = matchedPairs[i, 2]  # 1-based row index to remove
    dupFlag[idx, 1] = 1
  }

  # Indices of duplicates and uniques
  dupIdxs  = which(dupFlag == 1)
  keepIdxs = which(dupFlag == 0)

  #### Step 9: Build Output Frame ####
  if (returnDuplicates) {
    Y = X[dupIdxs, ]
  } else {
    Y = X[keepIdxs, ]
  }

  return(Y)
}

#---------------- Helper Functions ----------------#

computeDRMatrix = function(Frame[String] X, Matrix[String] vocab, Matrix[Double] gloveMatrix)
  return (Matrix[Double] V)
{
  n = nrow(X)
  d = ncol(gloveMatrix)
  V = matrix(0, rows=n, cols=d)

  for (i in 1:n) {
    line  = concat(X[i,])
    clean = lowerCase(trim(line))
    words = strsplit(clean, " ")

    sumVec = matrix(0, rows=1, cols=d)
    count  = 0
    for (w in words) {
      # linear lookup
      idx = -1
      for (m in 1:nrow(vocab)) {
        if (vocab[m,1] == w) {
          idx = m; break
        }
      }
      if (idx > 0) {
        sumVec = sumVec + gloveMatrix[idx, ]
        count  = count + 1
      }
    }
    V[i, ] = (count > 0) ? (sumVec / count) : sumVec
  }
}

computeLSH = function(Matrix[Double] V, Matrix[Double] H)
  return (Matrix[Int] hashCodes)
{
  P = V %*% t(H)
  hashCodes = (P >= 0)  # 1 if projection ≥0, else 0
}

formBuckets = function(Matrix[Int] hashCodes)
  return (Matrix[Int] bucketIDs)
{
  n = nrow(hashCodes)
  K = ncol(hashCodes)
  powers = matrix(0, rows=1, cols=K)
  for (k in 1:K) {
    powers[1, k] = 2^(K-k)
  }
  bucketIDs = hashCodes %*% t(powers)
}

#------------------ Entry Point ------------------#

# SystemDS test harness will pass in X, gloveMatrix, vocab,
# similarityMeasure, returnDuplicates, and expect variable Y.
Y = f_dedup(X, gloveMatrix, vocab, similarityMeasure, returnDuplicates)
